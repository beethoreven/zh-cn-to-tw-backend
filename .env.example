# 複製這份檔案為 .env，填入實際的值。.env 不會進版控。
# 這裡的值只是「後端預設值」，介面上的欄位可以每次上傳時個別覆蓋這些設定。

# Neon Postgres 連線字串。必填——沒有這個所有需要資料庫的操作都會直接
# 報錯（不再有 SQLite 退回機制）。本機開發、桌面版 App、Render 都是連
# 同一個資料庫，只有一種資料來源。
DATABASE_URL=

# --- Google 登入 ---

# 在 Google Cloud Console（APIs & Services → Credentials）申請的
# OAuth Client ID（Web application 類型），前端 Google Identity Services
# 初始化、後端驗證 ID Token 的 audience 都要用同一組
GOOGLE_CLIENT_ID=

# 授權白名單/管理員身份改成完全走 users/permissions 資料表管理（透過
# 管理員介面的「使用者管理」頁籤操作），不再需要環境變數設定授權名單。
# 第一次使用要先手動在 Neon 的 users 表塞至少一筆 status=active 的資料
# （本機開發跟 Render 連的是同一個 Neon），不然沒有任何人能登入。

# --- Stage 1：簡轉繁 ---

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 每批次送給 Gemini 潤飾的頁數，也可以填 whole 代表整本書只當一批
REFINE_BATCH_PAGES=20

# Gemini API 呼叫失敗（網路/暫時性錯誤）時最多重試幾次
REFINE_MAX_RETRY=3

# 前端 DPI 欄位的預設值（OCR 在使用者本機做，backend 本身不轉圖）
PDF_RENDER_DPI=200

# 各 model 每日呼叫次數上限，介面顯示「已用/上限」用（自行設定的參考值）
GEMINI_3_6_FLASH_RPD_LIMIT=20
GEMINI_3_5_FLASH_LITE_RPD_LIMIT=500

# --- Stage 2：校對 ---

# 每批送去校對的字數（不是頁數，Stage 1 輸出已經不保留頁界）
REVIEW_BATCH_CHARS=3000

REVIEW_MAX_RETRY=3

DEFAULT_REVIEW_MODEL=gemini-3.6-flash

# 不填就無法使用 Claude Haiku 校對（去 console.anthropic.com 申請）
ANTHROPIC_API_KEY=

# 這是 Anthropic API Console 帳單的 key，跟 Claude Code/Claude.ai 訂閱
# 方案是兩套獨立帳務系統，彼此無關
CLAUDE_MAX_OUTPUT_TOKENS=8192

# Claude Haiku 每百萬 token 價格（美元），Anthropic 調價時要跟著更新
# claude-opus-5 已於 2026-08-10 從可選 model 清單移除（費用過高），
# 對應的價格設定也一併拿掉
CLAUDE_HAIKU_PRICE_INPUT=1.0
CLAUDE_HAIKU_PRICE_OUTPUT=5.0

# --- 進階參數（不設定就用括號裡的預設值，平常不需要動） ---

# 登入 session 連續幾天完全沒用就過期（90）。過期的 session 會在下次被
# 使用時刪掉，backend 的背景清理也會每小時清一次。
# SESSION_IDLE_DAYS=90

# 白名單／管理員身份的快取秒數（30）。管理員停用帳號最慢這麼久後生效。
# AUTH_CACHE_TTL_SECONDS=30

# 單次 LLM 呼叫的逾時秒數，Gemini/Claude 共用（90）。
# LLM_CALL_TIMEOUT_SECONDS=90

# Stage 1 批次之間固定等幾秒，降低撞到 Gemini 每分鐘請求上限的機率（3）。
# BATCH_DELAY_SECONDS=3

# 遇到 429（額度用盡）時的退避基準秒數，第 N 次重試等 N 倍（20）。
# QUOTA_RETRY_BASE_DELAY_SECONDS=20

# 遇到 503/529（對方伺服器忙碌）時的退避基準秒數，第 N 次重試等 N 倍（5）。
# TRANSIENT_RETRY_BASE_DELAY_SECONDS=5

# Stage 1 潤飾後字數 ÷ 潤飾前字數的下限（0.7）：低於這個值代表 LLM 疑似把
# 內容摘要掉，捨棄這批潤飾、退回純簡轉繁。低於 WARN（0.9）只記警告、保留結果。
# REFINE_MIN_OUTPUT_RATIO=0.7
# REFINE_WARN_OUTPUT_RATIO=0.9

# 「個人專案」每天可以打幾次 Gemini 3.6 Flash（6），比一般專案嚴格很多。
# PERSONAL_PROJECT_GEMINI_FLASH_DAILY_LIMIT=6

# 本機開發才用：開啟 Flask 除錯模式（false）。正式環境絕對不要開，
# 錯誤頁會暴露完整 stack trace。
# FLASK_DEBUG=false
