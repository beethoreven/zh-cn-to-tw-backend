# 複製這份檔案為 .env，填入實際的值。.env 不會進版控。
# 這裡的值只是「後端預設值」，介面上的欄位可以每次上傳時個別覆蓋這些設定。

# 使用量記錄（usage_log）要接哪個資料庫。本機開發留空就好，會用本機
# SQLite（usage.db）。正式環境（Render）要填 Neon 的 Postgres 連線字串，
# 因為 Render 免費方案的檔案系統非持久性，SQLite 檔案撐不過重新部署。
DATABASE_URL=

# --- Google 登入 ---

# 在 Google Cloud Console（APIs & Services → Credentials）申請的
# OAuth Client ID（Web application 類型），前端 Google Identity Services
# 初始化、後端驗證 ID Token 的 audience 都要用同一組
GOOGLE_CLIENT_ID=

# 授權白名單/管理員身份改成完全走 users/permissions 資料表管理（透過
# 管理員介面的「使用者管理」頁籤操作），不再需要環境變數設定授權名單，
# 本機測試要先手動在 usage.db 的 users 表塞至少一筆 status=active 的
# 資料，正式環境同理要先在 Neon 塞好，不然沒有任何人能登入。

# --- Stage 1：簡轉繁 ---

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 每批次送給 Gemini 潤飾的頁數，也可以填 whole 代表整本書只當一批
REFINE_BATCH_PAGES=20

# Gemini API 呼叫失敗（網路/暫時性錯誤）時最多重試幾次
REFINE_MAX_RETRY=3

# PDF 轉圖片解析度（DPI），越高辨識越準但越慢
PDF_RENDER_DPI=200

# 各 model 每日呼叫次數上限，介面顯示「已用/上限」用（自行設定的參考值）
GEMINI_3_6_FLASH_RPD_LIMIT=20
GEMINI_3_5_FLASH_LITE_RPD_LIMIT=500

# --- Stage 2：校對 ---

# 每批送去校對的字數（不是頁數，Stage 1 輸出已經不保留頁界）
REVIEW_BATCH_CHARS=3000

REVIEW_MAX_RETRY=3

DEFAULT_REVIEW_MODEL=gemini-3.6-flash

# 不填就無法使用 Claude Haiku/Opus 校對（去 console.anthropic.com 申請）
ANTHROPIC_API_KEY=

# 這是 Anthropic API Console 帳單的 key，跟 Claude Code/Claude.ai 訂閱
# 方案是兩套獨立帳務系統，彼此無關
CLAUDE_MAX_OUTPUT_TOKENS=8192

# Claude 每百萬 token 價格（美元），Anthropic 調價時要跟著更新
CLAUDE_HAIKU_PRICE_INPUT=1.0
CLAUDE_HAIKU_PRICE_OUTPUT=5.0
CLAUDE_OPUS_PRICE_INPUT=5.0
CLAUDE_OPUS_PRICE_OUTPUT=25.0

# 「本月使用量」的計費週期起算日（1-31），預設每月 1 號。等你知道
# Anthropic Console 帳號實際的計費週期是哪一天，改這個數字對齊即可
USAGE_BILLING_CYCLE_START_DAY=1
